OPENAI_API_KEY=replace_with_your_server_key
PORT=8787
VITE_API_BASE_URL=

# --- โมเดลที่ใช้คิดคำตอบ ---
# ควรเป็นโมเดลข้อความที่ตอบเร็ว เพราะคำตอบถูกอ่านออกเสียงทันที (ค่าเริ่มต้น gpt-4.1-mini)
OPENAI_CHAT_MODEL=
# ที่อยู่ของ API ที่เข้ากันได้กับ OpenAI (ปกติไม่ต้องตั้ง)
OPENAI_BASE_URL=

# --- การเข้าสู่ระบบ ---
# ผู้ใช้และรหัสเข้าใช้งาน รูปแบบ ชื่อ:รหัส คั่นแต่ละคนด้วยจุลภาค เช่น light:รหัสของคุณไลท์,nurse:รหัสของพยาบาล
# ชื่อเป็นตัวอักษรอังกฤษ/ตัวเลข รหัสยาวอย่างน้อย 8 ตัวอักษรและห้ามมีจุลภาค
# เว้นว่าง = ไม่ต้องเข้าสู่ระบบ (ใช้ได้เฉพาะตอนพัฒนา ถ้า NODE_ENV=production จะปิดรับคำขอสนทนา)
ACCESS_CODES=
# กุญแจลงลายเซ็นโทเค็น ยาวอย่างน้อย 32 ตัวอักษร สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# เว้นว่าง = สุ่มใหม่ทุกครั้งที่เริ่มเซิร์ฟเวอร์ ผู้ใช้ต้องเข้าสู่ระบบใหม่หลังรีสตาร์ต
SESSION_SECRET=

# --- ความปลอดภัยของ backend ---
# ตั้งเป็น production บนเครื่องใช้งานจริง (ปิดต้นทางของ dev server และบังคับ HTTPS)
NODE_ENV=
# เว็บไซต์ที่อนุญาตให้เรียก API เพิ่มเติม คั่นด้วยจุลภาค เช่น https://javis.example.com
# (แอปมือถือ Capacitor และเว็บที่เสิร์ฟจาก backend เดียวกันได้รับอนุญาตอยู่แล้ว)
ALLOWED_ORIGINS=
# จำนวน reverse proxy ที่อยู่หน้า backend (ต่อตรง = 0, หลัง Render/Nginx 1 ชั้น = 1)
TRUST_PROXY=0
# จำนวนข้อความสูงสุดที่ผู้ใช้หนึ่งคนส่งได้ภายใน 10 นาที (นับตาม IP เมื่อไม่บังคับเข้าสู่ระบบ)
CHAT_RATE_LIMIT_MAX=100
