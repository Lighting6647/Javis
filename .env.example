OPENAI_API_KEY=replace_with_your_server_key
PORT=8787
VITE_API_BASE_URL=

# --- ผู้ให้บริการ AI ---
# ตั้งกุญแจของรายใดไว้ก็ใช้รายนั้น: ANTHROPIC_API_KEY (Claude), GEMINI_API_KEY (Google Gemini มีโควตาฟรี) หรือ OPENAI_API_KEY
# ถ้าตั้งไว้หลายราย จะใช้ Claude ก่อน ตามด้วย Gemini แล้วจึง OpenAI บังคับเลือกได้ด้วย AI_PROVIDER=claude, gemini หรือ openai
# Claude และ Gemini ไม่มีการแปลงเสียง แอปเดสก์ท็อปจึงต้องพิมพ์แทนการพูด ส่วนเว็บและมือถือพูดได้ตามปกติ
AI_PROVIDER=

# Claude ของ Anthropic: ขอกุญแจที่ Claude Console บัญชี API คิดค่าใช้จ่ายตามการใช้ แยกจากแพ็กเกจสมาชิกของแอป Claude
ANTHROPIC_API_KEY=
# โมเดลของ Claude (ค่าเริ่มต้น claude-haiku-5-5 ซึ่งราคาต่ำสุดและตอบเร็วที่สุด) รุ่นที่ฉลาดกว่าและแพงกว่า: claude-sonnet-5-5 หรือ claude-opus-5-5
ANTHROPIC_CHAT_MODEL=
# ระดับการคิดก่อนตอบของ Claude: low (ค่าเริ่มต้น เร็วที่สุด), medium, high, xhigh, max หรือ default เพื่อใช้ค่าของโมเดล
ANTHROPIC_EFFORT=
# ที่อยู่ของ Claude API (ปกติไม่ต้องตั้ง)
ANTHROPIC_BASE_URL=

# Google Gemini: ขอกุญแจที่ Google AI Studio มีโควตาฟรี (การค้นเว็บต้องเปิดเอง ดู WEB_SEARCH_ENABLED ด้านล่าง)
GEMINI_API_KEY=
# โมเดลของ Gemini (ค่าเริ่มต้น gemini-3.5-flash-lite ซึ่งอยู่ในโควตาฟรีและตอบเร็ว)
GEMINI_CHAT_MODEL=
# โมเดลของขั้นค้นเว็บ ใช้เมื่อ WEB_SEARCH_ENABLED=true (ค่าเริ่มต้น gemini-2.5-flash-lite ซึ่งโควตาฟรีค้นด้วย Google ได้ 500 ครั้งต่อวัน)
# ตั้งให้ตรงกับ GEMINI_CHAT_MODEL (Gemini 3 ขึ้นไป) เพื่อค้นและตอบในคำขอเดียว ซึ่งต้องเปิดการเรียกเก็บเงินของโปรเจกต์ก่อน
GEMINI_SEARCH_MODEL=
# ระดับการคิดก่อนตอบของ Gemini: minimal (ค่าเริ่มต้น เร็วที่สุด), low, medium, high หรือ default เพื่อใช้ค่าของโมเดล
GEMINI_REASONING_EFFORT=

# --- โมเดลที่ใช้คิดคำตอบ ---
# ควรเป็นโมเดลข้อความที่ตอบเร็ว เพราะคำตอบถูกอ่านออกเสียงทันที (ค่าเริ่มต้น gpt-4.1-mini)
OPENAI_CHAT_MODEL=
# ที่อยู่ของ API ที่เข้ากันได้กับ OpenAI (ปกติไม่ต้องตั้ง)
OPENAI_BASE_URL=
# โมเดลแปลงเสียงเป็นข้อความ ใช้เฉพาะแอปเดสก์ท็อปซึ่งต้องอัดเสียงส่งมา (ค่าเริ่มต้น gpt-transcribe)
OPENAI_TRANSCRIBE_MODEL=
# ให้ Javis ค้นเว็บเองเมื่อคำถามต้องใช้ข้อมูลล่าสุด (ผู้ให้บริการคิดค่าใช้จ่ายเพิ่มต่อการค้น และโมเดลที่ใช้ต้องรองรับเครื่องมือค้นเว็บ)
# เว้นว่าง = OpenAI และ Claude ค้นเว็บ (Claude คิดราว 1 เซนต์ต่อครั้ง) ส่วน Gemini ไม่ค้น
# true     = ค้นเว็บทุกราย รวมถึง Gemini ซึ่งค้นด้วย Google Search ฟรีในโควตาฟรี (500 ครั้งต่อวัน ด้วยโมเดลของ GEMINI_SEARCH_MODEL)
#            คำถามและคำตอบที่ค้นถูกส่งให้ Google Search และโควตาฟรีของ Google ใช้เนื้อหาปรับปรุงผลิตภัณฑ์ (ดู README หัวข้อ Google Gemini)
# false    = ปิดการค้นเว็บทุกราย
WEB_SEARCH_ENABLED=

# --- ตรวจบัญชี AI ตอนเริ่มเซิร์ฟเวอร์ ---
# ตรวจว่ากุญแจ API ใช้ได้และโมเดลที่ตั้งไว้มีอยู่จริง แล้วเตือนใน log และรายงานใน /health (ไม่มีค่าใช้จ่าย)
# ตั้งเป็น false เพื่อปิดการตรวจทั้งหมด
AI_STARTUP_CHECK=true
# ตรวจว่าเครดิตยังเหลือ ด้วยคำขอสั้นที่สุดหนึ่งครั้งต่อการเริ่มเซิร์ฟเวอร์ (ใช้โทเค็นราว 20 โทเค็น)
# ตั้งเป็น false ถ้าไม่ต้องการให้มีค่าใช้จ่ายนี้ สถานะเครดิตจะรู้เมื่อมีคำขอแรกของผู้ใช้แทน
AI_CREDIT_CHECK=true
# ระหว่างที่บัญชี AI ยังมีปัญหา ตรวจซ้ำทุกกี่วินาที เพื่อให้สถานะและแถบแจ้งเตือนในแอปกลับมาปกติเองหลังแก้ไข
# (ค่าเริ่มต้น 300 = 5 นาที ต่ำสุด 5) ตอนใช้งานได้ตามปกติจะไม่ตรวจซ้ำ จึงไม่มีค่าใช้จ่ายเพิ่ม
AI_RECHECK_SECONDS=300

# --- การเข้าสู่ระบบ ---
# ผู้ใช้และรหัสเข้าใช้งาน รูปแบบ ชื่อ:รหัส คั่นแต่ละคนด้วยจุลภาค เช่น light:รหัสของคุณไลท์,nurse:รหัสของพยาบาล
# ชื่อเป็นตัวอักษรอังกฤษ/ตัวเลข รหัสยาวอย่างน้อย 8 ตัวอักษรและห้ามมีจุลภาค
# เว้นว่าง = ไม่ต้องเข้าสู่ระบบ ใครเข้าถึงเซิร์ฟเวอร์ได้ก็ใช้ได้และใช้เครดิตของบัญชี AI ได้ (บนเว็บสาธารณะคือทุกคนที่มีลิงก์)
# ใส่ค่าแล้วแต่ไม่มีรายการใดถูกรูปแบบ = ปิดรับคำขอทั้งหมด จนกว่าจะแก้ให้ถูกหรือลบออก
ACCESS_CODES=
# กุญแจลงลายเซ็นโทเค็น ยาวอย่างน้อย 32 ตัวอักษร สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# เว้นว่าง = สุ่มใหม่ทุกครั้งที่เริ่มเซิร์ฟเวอร์ ผู้ใช้ต้องเข้าสู่ระบบใหม่หลังรีสตาร์ต
SESSION_SECRET=

# --- ความปลอดภัยของ backend ---
# ตั้งเป็น production บนเครื่องใช้งานจริง (ปิดต้นทางของ dev server และบังคับ HTTPS)
NODE_ENV=
# เว็บไซต์ที่อนุญาตให้เรียก API เพิ่มเติม คั่นด้วยจุลภาค เช่น https://javis.example.com
# (แอปมือถือ Capacitor และเว็บที่เสิร์ฟจาก backend เดียวกันได้รับอนุญาตอยู่แล้ว)
ALLOWED_ORIGINS=
# จำนวน reverse proxy ที่อยู่หน้า backend (ต่อตรง = 0, หลัง Nginx หรือโฮสต์ container 1 ชั้น = 1) บน Vercel ไม่ต้องตั้ง เซิร์ฟเวอร์ใช้ 1 ให้เอง
TRUST_PROXY=0
# จำนวนข้อความสูงสุดที่ผู้ใช้หนึ่งคนส่งได้ภายใน 10 นาที (นับตาม IP เมื่อไม่บังคับเข้าสู่ระบบ)
CHAT_RATE_LIMIT_MAX=100
